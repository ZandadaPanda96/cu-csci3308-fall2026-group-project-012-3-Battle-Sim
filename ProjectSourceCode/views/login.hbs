<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/login" method="POST" style="display:flex;flex-direction:column;align-items:center;">
        <h1>Login</h1>
        <div style="margin:0.5rem;padding:0.5rem;">
            <label for="username" style="display:block;">Username</label>
            <input type="text" name="username" style="display:block;">
        </div>

        <div style="margin:0.5rem;padding:0.5rem;">
            <label for="password" style="display:block;">Password</label>
            <input type="text" name="password" style="display:block;">
        </div>

        <button>Login</button>

        <p id="error_message" style="color:red;"></p>
    </form>
</body>
</html>